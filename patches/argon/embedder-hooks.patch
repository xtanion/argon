+void TabsQueryFunction::AppendExternalTabs(
+    BrowserWindowInterface* current_browser,
+    BrowserWindowInterface* last_active_browser,
+    const URLPatternSet& url_patterns,
+    const std::string& window_type,
+    int window_id,
+    int tab_index,
+    base::ListValue& result) {
+  ExtensionTabUtil::ExternalTabsDelegate* delegate =
+      ExtensionTabUtil::GetExternalTabsDelegate();
+  if (!delegate) {
+    return;
+  }
+  if (!window_type.empty() && window_type != "normal") {
+    return;
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  Profile* incognito_profile =
+      include_incognito_information()
+          ? profile->GetPrimaryOTRProfile(/*create_if_needed=*/false)
+          : nullptr;
+  for (Profile* candidate : {profile, incognito_profile}) {
+    if (!candidate) {
+      continue;
+    }
+    for (const auto& tab : delegate->GetTabs(candidate)) {
+      bool is_current = !current_browser && tab.focused_window;
+      bool is_last_focused = !last_active_browser && tab.focused_window;
+      if (window_id >= 0 && window_id != tab.window_id) {
+        continue;
+      }
+      if (window_id == extension_misc::kCurrentWindowId && !is_current) {
+        continue;
+      }
+      if (!MatchesBool(query_info_.current_window, is_current) ||
+          !MatchesBool(query_info_.last_focused_window, is_last_focused)) {
+        continue;
+      }
+      if (tab_index > -1 && tab.index != tab_index) {
+        continue;
+      }
+      if (!MatchesBool(query_info_.highlighted, tab.active) ||
+          !MatchesBool(query_info_.active, tab.active) ||
+          !MatchesBool(query_info_.pinned, tab.pinned)) {
+        continue;
+      }
+      if (query_info_.group_id.has_value() && *query_info_.group_id != -1) {
+        continue;
+      }
+      if (query_info_.split_view_id.has_value() &&
+          *query_info_.split_view_id != -1) {
+        continue;
+      }
+      if (!MatchesContents(tab.contents, url_patterns)) {
+        continue;
+      }
+      result.Append(CreateTabObjectHelper(tab.contents, extension(),
+                                          source_context_type(), nullptr,
+                                          tab.index)
+                        .ToValue());
+    }
+  }
+}
