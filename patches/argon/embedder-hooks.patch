+ExtensionFunction::ResponseValue WindowsUpdateFunction::UpdateExternalWindow(
+    const windows::Update::Params& params,
+    WindowController& window_controller) {
+  ui::BaseWindow* window = window_controller.window();
+  gfx::Rect bounds = window->IsMinimized() ? window->GetRestoredBounds()
+                                           : window->GetBounds();
+  const bool set_bounds = UpdateWindowBoundsFromParams(params, bounds);
+  if (set_bounds && !WindowBoundsIntersectDisplays(bounds)) {
+    return Error(tabs_constants::kInvalidWindowBoundsError);
+  }
+
+  switch (ConvertToWindowShowState(params.update_info.state)) {
+    case ui::mojom::WindowShowState::kMinimized:
+      window->Minimize();
+      break;
+    case ui::mojom::WindowShowState::kMaximized:
+      window->Maximize();
+      break;
+    case ui::mojom::WindowShowState::kNormal:
+      window->Restore();
+      break;
+    default:
+      break;
+  }
+  if (set_bounds) {
+    window->SetBounds(bounds);
+  }
+  if (params.update_info.focused.value_or(false)) {
+    window->Activate();
+  }
+  return WithArguments(window_controller.CreateWindowValueForExtension(
+      extension(), WindowController::kDontPopulateTabs,
+      source_context_type()));
+}
